{
  "name": "masterrecord",
  "version": "1.7.0",
  "description": "An Object-relational mapping for the Master framework. Master Record connects classes to relational database tables to establish a database with almost zero-configuration ",
  "type": "module",
  "main": "./MasterRecord.js",
  "exports": {
    ".": "./MasterRecord.js",
    "./context": "./context.js",
    "./ContextPool": "./ContextPool.js",
    "./Tools": "./Tools.js",
    "./SQLLiteEngine": "./SQLLiteEngine.js",
    "./mySQLEngine": "./mySQLEngine.js",
    "./postgresEngine": "./postgresEngine.js",
    "./mySQLConnect": "./mySQLConnect.js",
    "./postgresSyncConnect": "./postgresSyncConnect.js",
    "./insertManager": "./insertManager.js",
    "./deleteManager": "./deleteManager.js",
    "./Cache/QueryCache": "./Cache/QueryCache.js",
    "./Cache/RedisQueryCache": "./Cache/RedisQueryCache.js",
    "./Entity/entityModel": "./Entity/entityModel.js",
    "./Entity/entityModelBuilder": "./Entity/entityModelBuilder.js",
    "./Entity/entityTrackerModel": "./Entity/entityTrackerModel.js",
    "./Entity/fieldTransformer": "./Entity/fieldTransformer.js",
    "./QueryLanguage/queryMethods": "./QueryLanguage/queryMethods.js",
    "./QueryLanguage/queryParameters": "./QueryLanguage/queryParameters.js",
    "./QueryLanguage/queryScript": "./QueryLanguage/queryScript.js",
    "./Migrations/schema": "./Migrations/schema.js",
    "./Migrations/migrations": "./Migrations/migrations.js",
    "./Migrations/migrationTemplate": "./Migrations/migrationTemplate.js",
    "./package.json": "./package.json",
    "./errors": "./errors.js"
  },
  "bin": {
    "masterrecord": "Migrations/cli.js"
  },
  "files": [
    "*.js",
    "Cache/**/*.js",
    "Entity/**/*.js",
    "QueryLanguage/**/*.js",
    "Migrations/**/*.js",
    "!**/*.test.js",
    "!eslint.config.js",
    "!prettier.config.js",
    "docs/**/*.md",
    "CHANGES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/integration/*.test.js Migrations/pathUtils.test.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "author": "Alexandr Rich",
  "license": "MIT",
  "homepage": "https://github.com/Tailor/MasterRecord#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tailor/Masterrecord.git"
  },
  "keywords": [
    "orm",
    "database",
    "migrations",
    "mysql",
    "sqlite",
    "postgres",
    "esm",
    "masterrecord"
  ],
  "dependencies": {
    "better-sqlite3": ">=12.6.2 <14",
    "commander": "^15.0.0",
    "deep-object-diff": "^1.1.9",
    "glob": "^13.0.6",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  }
}
